# ==============================================================================
# Hardened Tor Configuration for AdGuard Home DNS & Proxy Gateway
# Default Location on Windows: C:\Program Files\Tor\torrc or DataDirectory\torrc
# ==============================================================================

# Core Network & Ports
SocksPort 127.0.0.1:9050
DNSPort 127.0.0.1:5350

# Isolate traffic per client connection & credentials
SocksPolicy accept 127.0.0.1
SocksPolicy reject *

# Security & Anti-Leak Hardening
ClientOnly 1
SafeLogging 1
GeoIPExcludeUnknown 1
StrictNodes 0

# Onion Routing & DNS
AutomapHostsOnResolve 1
AutomapHostsSuffixes .onion,.exit

# Performance & Circuit Stability
NumEntryGuards 3
CircuitBuildTimeout 10
KeepalivePeriod 60
NewCircuitPeriod 30
MaxCircuitDirtiness 600

# Prevent local DNS / IPv6 leaks
TestSocks 0
WarnUnsafeSocks 1
