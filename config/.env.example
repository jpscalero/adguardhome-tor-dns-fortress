# ==============================================================================
# AdGuard Home Fortress Environment Variables Example
# Rename this file to .env and configure your credentials
# ==============================================================================

# AdGuard Home Web Admin Credentials (used by AI Sentinel)
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=your_secure_password_here

# Google Gemini API Key (Optional: for advanced AI domain anomaly analysis)
GEMINI_API_KEY=your_gemini_api_key_here
