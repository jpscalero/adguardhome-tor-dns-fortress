# ==============================================================================
# AdGuard Home Fortress - variables de entorno (plantilla)
# Copia este fichero como config/.env y rellena los valores.
# Despues ejecuta: powershell -ExecutionPolicy Bypass -File scripts\harden-env-acl.ps1
# ==============================================================================

# --- Panel de AdGuard Home (usado por el centinela) ---------------------------
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=cambia_esto

# --- Analisis IA --------------------------------------------------------------
# off       : sin llamadas externas, solo heuristicas locales
# local     : modelo local (Ollama), el dominio no sale del equipo
# aggregate : a la nube solo va un hash con sal + metadatos  (recomendado)
# full      : se envia el dominio completo (maxima deteccion, cero privacidad)
AI_MODE=aggregate
# Perfil DNS: tor (DoH por puente Tor), privacy (Unbound recursivo), speed o censorship.
# tor/speed/censorship usan el puente local 127.0.0.1:5336 -> 127.0.0.1:9050.
# Lo aplica scripts/apply-dns-profile.ps1; no edites AdGuardHome.yaml a mano.
DNS_PROFILE=tor

# Necesaria salvo en AI_MODE=off/local
GEMINI_API_KEY=

# Modelo local para AI_MODE=local
AI_LOCAL_URL=http://127.0.0.1:11434
AI_LOCAL_MODEL=llama3.2

# Sal opcional para los hashes. Si se deja vacia se genera en data/ai_salt.txt
AI_HASH_SALT=

# --- Tor ----------------------------------------------------------------------
# Contrasena del ControlPort para rotar circuito (SIGNAL NEWNYM).
# Genera el hash con: tor.exe --hash-password "tu_contrasena"
TOR_CONTROL_PASSWORD=

# --- Rutas --------------------------------------------------------------------
# Ruta base de la fortaleza. Si se omite, el codigo usa su propia ubicacion.
FORTRESS_DIR=C:\AdGuardHome
