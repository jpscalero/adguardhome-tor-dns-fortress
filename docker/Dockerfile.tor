# Tor cliente para el perfil Docker de la fortaleza.
# Se empaqueta en la imagen (sin "apk add" en runtime) para que el arranque sea
# reproducible y el healthcheck tenga netcat disponible.
FROM alpine:3.20

RUN apk add --no-cache tor netcat-openbsd \
    && (id tor >/dev/null 2>&1 || adduser -D -H -s /sbin/nologin tor) \
    && mkdir -p /var/lib/tor \
    && chown -R tor:tor /var/lib/tor \
    && chmod 700 /var/lib/tor

COPY torrc /etc/tor/torrc
RUN chmod 644 /etc/tor/torrc

# El volumen nombrado hereda propietario y permisos de esta carpeta al crearse.
VOLUME ["/var/lib/tor"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD nc -z 127.0.0.1 9050 || exit 1

ENTRYPOINT ["tor", "-f", "/etc/tor/torrc"]
